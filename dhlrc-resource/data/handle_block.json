{
    "_note": "Block -> item mapping behind the material list. Schema 3. Exact tables are checked first (ignore, then single, then multi); remaining blocks go through pattern_rules in order, first match wins. In a pattern, '*' matches one or more characters, exactly one '*' is allowed, and 'to' may use the captured text once. Then units_rules say how many items one block yields when the block state carries a count (a double slab is two slabs, a snow block with 8 layers is eight snow), and pair_items say which items put down two block positions (a door is two blocks but one item). Maintained by scripts/gen_handle_block.py: run its 'check' mode against client jars after editing.",
    "schema": 3,
    "ignore_block": [
        "minecraft:air",
        "minecraft:cave_air",
        "minecraft:end_gateway",
        "minecraft:end_portal",
        "minecraft:fire",
        "minecraft:moving_piston",
        "minecraft:nether_portal",
        "minecraft:piston_head",
        "minecraft:soul_fire",
        "minecraft:void_air"
    ],
    "replace_single_block": {
        "minecraft:attached_melon_stem": "minecraft:melon_seeds",
        "minecraft:attached_pumpkin_stem": "minecraft:pumpkin_seeds",
        "minecraft:bamboo_sapling": "minecraft:bamboo",
        "minecraft:beetroots": "minecraft:beetroot_seeds",
        "minecraft:big_dripleaf_stem": "minecraft:big_dripleaf",
        "minecraft:bubble_column": "minecraft:water_bucket",
        "minecraft:carrots": "minecraft:carrot",
        "minecraft:cave_vines": "minecraft:glow_berries",
        "minecraft:cave_vines_plant": "minecraft:glow_berries",
        "minecraft:cocoa": "minecraft:cocoa_beans",
        "minecraft:frosted_ice": "minecraft:water_bucket",
        "minecraft:kelp_plant": "minecraft:kelp",
        "minecraft:lava": "minecraft:lava_bucket",
        "minecraft:melon_stem": "minecraft:melon_seeds",
        "minecraft:pitcher_crop": "minecraft:pitcher_pod",
        "minecraft:potatoes": "minecraft:potato",
        "minecraft:powder_snow": "minecraft:powder_snow_bucket",
        "minecraft:pumpkin_stem": "minecraft:pumpkin_seeds",
        "minecraft:redstone_wire": "minecraft:redstone",
        "minecraft:sweet_berry_bush": "minecraft:sweet_berries",
        "minecraft:tall_seagrass": "minecraft:seagrass",
        "minecraft:torchflower_crop": "minecraft:torchflower_seeds",
        "minecraft:tripwire": "minecraft:string",
        "minecraft:twisting_vines_plant": "minecraft:twisting_vines",
        "minecraft:wall_torch": "minecraft:torch",
        "minecraft:water": "minecraft:water_bucket",
        "minecraft:weeping_vines_plant": "minecraft:weeping_vines",
        "minecraft:wheat": "minecraft:wheat_seeds"
    },
    "replace_multi_block": {
        "minecraft:candle_cake": [
            "minecraft:cake",
            "minecraft:candle"
        ],
        "minecraft:potted_azalea_bush": [
            "minecraft:flower_pot",
            "minecraft:azalea"
        ],
        "minecraft:potted_flowering_azalea_bush": [
            "minecraft:flower_pot",
            "minecraft:flowering_azalea"
        ]
    },
    "units_rules": [
        {
            "match": "minecraft:*_slab",
            "property": "type",
            "value": "double",
            "units": 2
        },
        {
            "match": "minecraft:snow",
            "property": "layers"
        },
        {
            "match": "minecraft:candle",
            "property": "candles"
        },
        {
            "match": "minecraft:*_candle",
            "property": "candles"
        },
        {
            "match": "minecraft:sea_pickle",
            "property": "pickles"
        },
        {
            "match": "minecraft:turtle_egg",
            "property": "eggs"
        },
        {
            "match": "minecraft:pink_petals",
            "property": "flower_amount"
        },
        {
            "match": "minecraft:wildflowers",
            "property": "flower_amount"
        },
        {
            "match": "minecraft:leaf_litter",
            "property": "segment_amount"
        }
    ],
    "pair_items": [
        "minecraft:*_bed",
        "minecraft:*_door",
        "minecraft:big_dripleaf",
        "minecraft:large_fern",
        "minecraft:lilac",
        "minecraft:peony",
        "minecraft:pitcher_plant",
        "minecraft:rose_bush",
        "minecraft:sunflower",
        "minecraft:tall_grass"
    ],
    "pattern_rules": [
        {
            "match": "minecraft:*_wall_hanging_sign",
            "action": "single",
            "to": "minecraft:*_hanging_sign"
        },
        {
            "match": "minecraft:*_wall_sign",
            "action": "single",
            "to": "minecraft:*_sign"
        },
        {
            "match": "minecraft:*_wall_banner",
            "action": "single",
            "to": "minecraft:*_banner"
        },
        {
            "match": "minecraft:*_wall_skull",
            "action": "single",
            "to": "minecraft:*_skull"
        },
        {
            "match": "minecraft:*_wall_head",
            "action": "single",
            "to": "minecraft:*_head"
        },
        {
            "match": "minecraft:*_wall_torch",
            "action": "single",
            "to": "minecraft:*_torch"
        },
        {
            "match": "minecraft:*_coral_wall_fan",
            "action": "single",
            "to": "minecraft:*_coral_fan"
        },
        {
            "match": "minecraft:potted_*",
            "action": "multi",
            "to": [
                "minecraft:flower_pot",
                "minecraft:*"
            ]
        },
        {
            "match": "minecraft:*_candle_cake",
            "action": "multi",
            "to": [
                "minecraft:cake",
                "minecraft:*_candle"
            ]
        },
        {
            "match": "minecraft:*_cauldron",
            "action": "multi",
            "to": [
                "minecraft:cauldron",
                "minecraft:*_bucket"
            ]
        }
    ]
}
