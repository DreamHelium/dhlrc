<?xml version="1.0" encoding="UTF-8" ?>
<kcfg
    xmlns="http://www.kde.org/standards/kcfg/1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd"
>
    <group name="General">
        <entry name="MemoryLimit" type="Int">
            <label>Application Memory Limit</label>
            <tooltip>The limit memory(bytes) for application.</tooltip>
            <default>524288000</default>
        </entry>
        <entry name="LimitUnit" type="Enum">
            <!-- This will not render -->
            <choices>
                <choice name="GiB">
                </choice>
                <choice name="MiB">
                </choice>
                <choice name="KiB">
                </choice>
                <choice name="Bytes">
                </choice>
            </choices>
        </entry>
        <entry name="ElapsedMilliseconds" type="Int">
            <label>Elapsed Milliseconds</label>
            <tooltip
            >The elapsed milliseconds for the progress bar, if set too small will affect the speed.</tooltip>
            <default>500</default>
        </entry>
        <entry name="SelectAllRegionsInLoading" type="Bool">
            <label>Select All Regions In Loading</label>
            <tooltip
            >If you check this, all regions will be loaded in the loading progress.</tooltip>
            <default>false</default>
        </entry>
        <entry name="LoadingFileByExtension" type="Bool">
            <label>Loading File by File Extension</label>
            <tooltip
            >If you check this, the file will be loaded by the file extension name.</tooltip>
            <default>true</default>
        </entry>
        <entry name="FailThenRetry" type="Bool">
            <label>Retry Loading File when Failed</label>
            <tooltip
            >When failed, the file will try to be loaded by other modules.</tooltip>
            <default>false</default>
        </entry>
        <entry name="CacheDirectory" type="Path">
            <label>Cache Directory</label>
            <tooltip>The directory to store cache files.</tooltip>
            <default
                code="true"
            >QStandardPaths::writableLocation (QStandardPaths::CacheLocation)</default>
        </entry>
        <entry name="FailDownloadUseCache" type="Bool">
            <label>Use Cached File when Downloading Failed</label>
            <tooltip>When downloading failed, use the cached file.</tooltip>
            <default>false</default>
        </entry>
    </group>
    <group name="Default">
        <entry name="BaseName" type="String">
            <label>Region Base Name</label>
            <tooltip>The default base name for the region.</tooltip>
            <default code="true">i18n("Converted")</default>
        </entry>
        <entry name="RegionName" type="String">
            <label>Region Name</label>
            <tooltip>The default name for the region.</tooltip>
            <default code="true">i18n("Unnamed")</default>
        </entry>
        <entry name="Description" type="String">
            <label>Region Description</label>
            <tooltip>The default description for the region.</tooltip>
        </entry>
        <entry name="Author" type="String">
            <label>Region Author</label>
            <tooltip>The default author for the region.</tooltip>
        </entry>
    </group>
    <group name="Game">
        <entry name="OverrideSetting" type="Bool">
            <label>Override Settings</label>
            <tooltip>Whether to override setting or not.</tooltip>
            <default>false</default>
        </entry>
        <entry name="OverrideVersion" type="String">
            <label>Override Version</label>
            <tooltip>The version to override in translation stage.</tooltip>
        </entry>
    </group>
    <group name="Manage">

    </group>
    <group name="Reader">
        <entry name="DefaultShowOption" type="Enum">
            <label>Default Show Option</label>
            <tooltip>The default option of showing block information.</tooltip>
            <choices>
                <choice name="Palette">
                    <label>Palette</label>
                </choice>
                <choice name="Name">
                    <label>Name</label>
                </choice>
            </choices>
            <default>0</default>
        </entry>
    </group>
</kcfg>
